{
  "schemaVersion": 1,
  "id": "io.github.loupibe.system-monitor",
  "name": "System Monitor",
  "version": "1.0.0",
  "author": "LoupiBe",
  "license": "MIT",
  "description": "Live CPU, RAM, and bandwidth monitor with lightweight detail popup panel for the Omarchy top bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "System Monitor",
    "description": "Live CPU, RAM, and bandwidth monitor with overview panel",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "refreshIntervalSec": 2,
      "showCpu": true,
      "showMemory": true,
      "showNetwork": true,
      "showTemp": false,
      "cpuAlertPercent": 85,
      "memAlertPercent": 85
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 1,
        "max": 10,
        "step": 1,
        "defaultValue": 2
      },
      {
        "key": "showCpu",
        "type": "boolean",
        "label": "Show CPU in bar",
        "defaultValue": true
      },
      {
        "key": "showMemory",
        "type": "boolean",
        "label": "Show Memory in bar",
        "defaultValue": true
      },
      {
        "key": "showNetwork",
        "type": "boolean",
        "label": "Show Network in bar",
        "defaultValue": true
      },
      {
        "key": "showTemp",
        "type": "boolean",
        "label": "Show CPU temperature in bar",
        "defaultValue": false
      },
      {
        "key": "cpuAlertPercent",
        "type": "integer",
        "label": "CPU alert threshold (%)",
        "min": 50,
        "max": 99,
        "step": 5,
        "defaultValue": 85
      },
      {
        "key": "memAlertPercent",
        "type": "integer",
        "label": "Memory alert threshold (%)",
        "min": 50,
        "max": 99,
        "step": 5,
        "defaultValue": 85
      }
    ]
  }
}

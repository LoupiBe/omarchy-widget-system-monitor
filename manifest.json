{
  "schemaVersion": 1,
  "id": "io.github.loupibe.system-monitor",
  "name": "System Monitor",
  "version": "1.0.0",
  "author": "LoupiBe",
  "license": "MIT",
  "description": "Live CPU, RAM, and bandwidth monitor with lightweight detail popup panel for the Omarchy top bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "System Monitor",
    "description": "Live CPU, RAM, and bandwidth monitor with overview panel",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "refreshIntervalSec": 2,
      "showCpu": true,
      "showMemory": true,
      "showDisk": false,
      "showNetwork": true,
      "showTemp": false,
      "panelShowCpu": true,
      "panelShowMemory": true,
      "panelShowDisk": true,
      "panelShowNetwork": true,
      "cpuAlertPercent": 85,
      "memAlertPercent": 85,
      "diskAlertPercent": 90,
      "showGpu": false,
      "panelShowGpu": false,
      "gpuAlertPercent": 85,
      "historyStyle": "sparkline",
      "historySize": "normal",
      "historyPoints": 20,
      "showCpuHistory": true,
      "showNetworkHistory": true,
      "showMemoryHistory": false,
      "showDiskHistory": false,
      "showGpuHistory": false,
      "barOrder": ["cpu", "memory", "disk", "network"],
      "panelOrder": ["cpu", "memory", "storage", "network"]
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 1,
        "max": 10,
        "step": 1,
        "defaultValue": 2
      },
      {
        "key": "showCpu",
        "type": "boolean",
        "label": "Show CPU in bar",
        "defaultValue": true
      },
      {
        "key": "showGpu",
        "type": "boolean",
        "label": "Show GPU in bar",
        "defaultValue": false
      },
      {
        "key": "showMemory",
        "type": "boolean",
        "label": "Show Memory in bar",
        "defaultValue": true
      },
      {
        "key": "showDisk",
        "type": "boolean",
        "label": "Show Storage (Disk) in bar",
        "defaultValue": false
      },
      {
        "key": "showNetwork",
        "type": "boolean",
        "label": "Show Network in bar",
        "defaultValue": true
      },
      {
        "key": "showTemp",
        "type": "boolean",
        "label": "Show CPU temperature in bar",
        "defaultValue": false
      },
      {
        "key": "barOrder",
        "type": "list",
        "label": "Top bar metric order",
        "defaultValue": ["cpu", "memory", "disk", "network"],
        "description": "Order of metric slots on the top bar pill (e.g. ['cpu', 'memory', 'disk', 'network'] or 'disk, cpu, memory, network')."
      },
      {
        "key": "panelShowCpu",
        "type": "boolean",
        "label": "Show CPU in overview panel",
        "defaultValue": true
      },
      {
        "key": "panelShowGpu",
        "type": "boolean",
        "label": "Show GPU inside CPU panel in overview",
        "defaultValue": false
      },
      {
        "key": "panelShowMemory",
        "type": "boolean",
        "label": "Show Memory in overview panel",
        "defaultValue": true
      },
      {
        "key": "panelShowDisk",
        "type": "boolean",
        "label": "Show Storage (Disk) in overview panel",
        "defaultValue": true
      },
      {
        "key": "panelShowNetwork",
        "type": "boolean",
        "label": "Show Network in overview panel",
        "defaultValue": true
      },
      {
        "key": "historyStyle",
        "type": "string",
        "label": "History timeline style ('sparkline', 'bars', 'area')",
        "defaultValue": "sparkline"
      },
      {
        "key": "historySize",
        "type": "string",
        "label": "History graph height ('micro', 'small', 'normal', 'big', 'huge')",
        "defaultValue": "normal"
      },
      {
        "key": "historyPoints",
        "type": "integer",
        "label": "History sample count (timeline window)",
        "min": 5,
        "max": 60,
        "step": 5,
        "defaultValue": 20
      },
      {
        "key": "showCpuHistory",
        "type": "boolean",
        "label": "Show timeline sparkline in CPU panel",
        "defaultValue": true
      },
      {
        "key": "showNetworkHistory",
        "type": "boolean",
        "label": "Show timeline sparkline in Network panel",
        "defaultValue": true
      },
      {
        "key": "showMemoryHistory",
        "type": "boolean",
        "label": "Show timeline sparkline in Memory panel",
        "defaultValue": false
      },
      {
        "key": "showDiskHistory",
        "type": "boolean",
        "label": "Show timeline sparkline in Storage panel",
        "defaultValue": false
      },
      {
        "key": "showGpuHistory",
        "type": "boolean",
        "label": "Show timeline sparkline in GPU panel",
        "defaultValue": false
      },
      {
        "key": "panelOrder",
        "type": "list",
        "label": "Overview panel section order",
        "defaultValue": ["cpu", "memory", "storage", "network"],
        "description": "Order of sections in the popup overview panel (e.g. ['cpu', 'memory', 'storage', 'network'] or 'storage, cpu, memory, network')."
      },
      {
        "key": "cpuAlertPercent",
        "type": "integer",
        "label": "CPU alert threshold (%)",
        "min": 50,
        "max": 99,
        "step": 5,
        "defaultValue": 85
      },
      {
        "key": "gpuAlertPercent",
        "type": "integer",
        "label": "GPU alert threshold (%)",
        "min": 50,
        "max": 99,
        "step": 5,
        "defaultValue": 85
      },
      {
        "key": "memAlertPercent",
        "type": "integer",
        "label": "Memory alert threshold (%)",
        "min": 50,
        "max": 99,
        "step": 5,
        "defaultValue": 85
      },
      {
        "key": "diskAlertPercent",
        "type": "integer",
        "label": "Disk alert threshold (%)",
        "min": 50,
        "max": 99,
        "step": 5,
        "defaultValue": 90
      }
    ]
  }
}
